    {
      "name": "02 Owner - Current",
      "description": "Current owner flow for centers and teachers. Create center first, then use the saved centerId as tenantId for teacher requests.",
      "item": [
        {
          "name": "Create Center",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('centerId', json.id);",
                  "    pm.collectionVariables.set('tenantId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{centerName}}\",\n  \"subdomain\": \"{{centerSubdomain}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/owner/centers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owner",
                "centers"
              ]
            },
            "description": "Create a center as OWNER. This request also saves centerId and tenantId for later requests."
          },
          "response": []
        },
        {
          "name": "Get Centers",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/owner/centers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owner",
                "centers"
              ]
            },
            "description": "List centers visible to the current OWNER."
          },
          "response": []
        },
        {
          "name": "Get Center By Id",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/owner/centers/{{centerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owner",
                "centers",
                "{{centerId}}"
              ]
            },
            "description": "Get details of one center."
          },
          "response": []
        },
        {
          "name": "Create Teacher",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"{{teacherFullName}}\",\n  \"email\": \"{{teacherEmail}}\",\n  \"phoneNumber\": \"{{teacherPhone}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/owner/teachers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owner",
                "teachers"
              ]
            },
            "description": "Create a TEACHER inside the current center."
