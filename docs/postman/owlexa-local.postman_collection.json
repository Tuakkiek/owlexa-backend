            "url": {
              "raw": "{{baseUrl}}/owner/teachers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "owner",
                "teachers"
              ]
            },
            "description": "List teachers inside the current center."
          },
          "response": []
        }
      ]
