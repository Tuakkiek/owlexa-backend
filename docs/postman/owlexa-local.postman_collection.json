  "item": [
    {
      "name": "01 Auth - Current",
      "description": "Current auth flow. Register STUDENT and OWNER, then login and save token into collection variables.",
      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('studentToken', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{studentPhone}}\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"fullName\": \"{{studentFullName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/student",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register",
                "student"
              ]
            },
            "description": "Self-register a STUDENT account."
          },
          "response": []
        },
