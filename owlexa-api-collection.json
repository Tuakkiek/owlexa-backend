        {
          "name": "Create Center",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = null;",
                  "try {",
                  "  jsonData = pm.response.json();",
                  "} catch (e) {",
                  "  jsonData = null;",
                  "}",
                  "",
                  "var centerId = null;",
                  "if (jsonData) {",
                  "  centerId = jsonData.id || jsonData.centerId || (jsonData.data && (jsonData.data.id || jsonData.data.centerId));",
                  "}",
                  "",
                  "if (centerId) {",
                  "  pm.collectionVariables.set(\"centerId\", String(centerId));",
                  "  pm.collectionVariables.set(\"tenantId\", String(centerId));",
                  "  console.log(\"Saved centerId and tenantId to collection variables!\");",
                  "}"
