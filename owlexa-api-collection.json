  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var method = (pm.request.method || \"\").toUpperCase();",
          "var hasRawBody = pm.request.body && pm.request.body.mode === \"raw\";",
          "if (hasRawBody && [\"POST\", \"PUT\", \"PATCH\", \"DELETE\"].indexOf(method) !== -1) {",
          "    pm.request.headers.upsert({ key: \"Content-Type\", value: \"application/json\" });",
          "}",
          "",
          "var tenantId = pm.collectionVariables.get(\"tenantId\") || pm.environment.get(\"tenantId\") || pm.variables.get(\"tenantId\");",
          "if (tenantId) {",
          "    var path = \"\";",
          "    if (pm.request.url && typeof pm.request.url.getPath === \"function\") {",
          "        path = pm.request.url.getPath().join(\"/\");",
          "    }",
          "",
          "    if (path.indexOf(\"owner/teachers\") === 0 || path.indexOf(\"owner/cashiers\") === 0 || path.indexOf(\"owner/students\") === 0) {",
          "        pm.request.headers.upsert({ key: \"X-Tenant-ID\", value: String(tenantId) });",
          "    }",
          "}"
        ]
      }
    },
