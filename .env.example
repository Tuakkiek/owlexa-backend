# ============================================================
# Owlexa Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in values for your environment.
#
#   cp .env.example .env
#
# For local development, all variables have safe defaults
# defined in application.properties — no .env file is needed.
#
# For production deployment, you MUST set all three variables.
# ============================================================

# --- Database Configuration ---

# MySQL connection URL.
# Development default: jdbc:mysql://localhost:3306/owlexa_db
# Production example:  jdbc:mysql://your-vps-ip:3306/owlexa_db?useSSL=true&...
DB_URL=jdbc:mysql://localhost:3306/owlexa_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8&useUnicode=true

# MySQL password for the configured user.
# Development default: 123456
DB_PASSWORD=your_secure_db_password_here

# --- JWT Security ---

# JWT signing secret. Must be at least 256 bits (32 ASCII characters).
# Generate a secure random key:
#   openssl rand -base64 32
# Development default: owlexa-super-secret-key-minimum-256-bits-long-change-in-production-env
JWT_SECRET=your_secure_random_jwt_secret_here

# --- Server (optional) ---

# Server port. Default: 8081
# SERVER_PORT=8081

# --- AI Scoring ---

# DeepSeek API Key for AI essay scoring
AI_API_KEY=your_deepseek_api_key_here

# Optional AI grading overrides.
# Responses API on DeepSeek currently supports deepseek-v4-flash.
# AI_GRADING_MODEL=deepseek-v4-flash
# AI_GRADING_MAX_TOKENS=8000
# AI_GRADING_TIMEOUT_MS=60000

